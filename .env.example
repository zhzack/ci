# Configuration file loaded by the service.
MINI_PIPELINE_CONFIG=config/default.yaml

# Used by config/docker.yaml (Docker Compose injects these).
DATABASE_URL=postgresql+psycopg://mini_pipeline:mini_pipeline@database:5432/mini_pipeline

# docker.yaml enables API auth with strict ${VAR} expansion — all three
# must be set or the service refuses to start. Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LOG_LEVEL=INFO
MINI_PIPELINE_ADMIN_TOKEN=change-me-admin-token
MINI_PIPELINE_READER_TOKEN=change-me-reader-token

# Encrypts admin-machine credentials at rest (Fernet, derive from env).
MINI_PIPELINE_SECRET_KEY=change-me-fernet-secret-key

# ==============================================================================
# Mini Pipeline 生产环境配置模板
# 部署前请复制为 .env 并按需修改
# ==============================================================================

# 应用版本号与镜像源（如果使用私有镜像仓库，例如: harbor.example.com/ci/）
APP_VERSION=0.3.0
IMAGE_REGISTRY=

# 访问端口配置
FRONTEND_PORT=80
API_PORT=8000

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 数据库配置（单机部署默认保留；如果使用外部独立 PostgreSQL，请配置 DATABASE_URL）
# ------------------------------------------------------------------------------
DB_USER=mini_pipeline
DB_PASSWORD=mini_pipeline
# 独立外部数据库连接串示例（启用外部数据库时取消注释）：
# DATABASE_URL=postgresql+psycopg://user:password@192.168.1.100:5432/mini_pipeline

# ------------------------------------------------------------------------------
# 安全凭证三件套（必须修改！严禁使用默认值）
# 可使用命令生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
MINI_PIPELINE_ADMIN_TOKEN=REPLACE_WITH_A_SECURE_RANDOM_ADMIN_TOKEN
MINI_PIPELINE_READER_TOKEN=REPLACE_WITH_A_SECURE_RANDOM_READER_TOKEN
MINI_PIPELINE_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_FERNET_SECRET_KEY

# SMTP 发信授权码（被封锁出站 SMTP 的主机另需 SMTP_PROXY，如 socks5://127.0.0.1:7897）
# SMTP_PASSWORD=your-smtp-auth-code
# SMTP_PROXY=
